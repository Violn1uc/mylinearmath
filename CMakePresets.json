{
    "version": 2,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "macos-arm64",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/macos-arm64",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt"
            }
        },
        {
            "name": "macos-x64",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/macos-intel",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-osx",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
                "CMAKE_PREFIX_PATH": "/usr/local/opt/qt"
            }
        }
    ]
}